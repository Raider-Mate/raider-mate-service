DATABASE_URL=postgres://raider-mate:raider-mate@localhost:5432/raider-mate?sslmode=disable
ADDR=:8080
LOG_LEVEL=info
SERVICE_API_KEY=dev-local-key

# cmd/worker
SYNC_INTERVAL=5m
SYNC_STALE_AFTER=6h
SYNC_BATCH=50
RAIDERIO_BASE_URL=https://raider.io
# Optional. Register an application at https://raider.io/settings/apps to raise the
# request rate. Empty means anonymous access.
RAIDERIO_ACCESS_KEY=
RAIDERIO_MIN_INTERVAL=250ms
JOB_POLL_INTERVAL=30s
JOB_BATCH=100

# The season's game data. Neither can be read off a Raider.IO response, and leaving
# either empty stops the matching field appearing on a character rather than reporting
# a zero: no tier configured is not the same as a raider wearing none of it.
# Every class-set item id of the current season, comma separated.
TIER_SET_ITEM_IDS=
# Raider.IO's slug for the raid the roster is measured on, e.g. manaforge-omega.
CURRENT_RAID_SLUG=

# WarcraftLogs, for reading the report a raid lead attaches to an event. Register a
# client at https://www.warcraftlogs.com/api/clients/ and ignore the redirect URI field
# on that page: this service authenticates with client credentials and never redirects.
#
# The budget is 3600 points an hour PER CLIENT KEY, and a full report costs about
# eighteen. Every guild that has not supplied its own key shares this one, so a busy
# instance will want guilds to bring their own; WarcraftLogs' Gold and Platinum
# subscriptions also raise the ceiling.
#
# Leave both empty and the feature is simply off: no reports are read, and the stored
# URL still reads back exactly as it always did.
WARCRAFT_LOGS_CLIENT_ID=
WARCRAFT_LOGS_API_KEY=

# Seals a guild's own WarcraftLogs key before it reaches the database. 32 bytes, base64:
#   openssl rand -base64 32
# Without it the service refuses to store a guild-supplied key rather than writing it in
# the clear. Losing it makes every stored guild key unreadable, which is recoverable only
# by each guild pasting its key again.
WARCRAFT_LOGS_ENCRYPTION_KEY=

# Worker tuning. Defaults shown.
#WARCRAFT_LOGS_POLL_INTERVAL=5m
#WARCRAFT_LOGS_BATCH=5
#WARCRAFT_LOGS_MIN_INTERVAL=1s
# How often a report that is still being written to gets re-read. A raid night appends to
# its report while it runs, and a report that has stopped changing is never re-read.
#WARCRAFT_LOGS_LIVE_REFRESH=15m
