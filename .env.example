DATABASE_URL=postgres://raider-mate:raider-mate@localhost:5432/raider-mate?sslmode=disable
ADDR=:8080
LOG_LEVEL=info
SERVICE_API_KEY=dev-local-key

# cmd/worker
SYNC_INTERVAL=5m
SYNC_STALE_AFTER=6h
SYNC_BATCH=50
RAIDERIO_BASE_URL=https://raider.io
# Optional. Register an application at https://raider.io/settings/apps to raise the
# request rate. Empty means anonymous access.
RAIDERIO_ACCESS_KEY=
RAIDERIO_MIN_INTERVAL=250ms
JOB_POLL_INTERVAL=30s
JOB_BATCH=100

# The season's game data. Neither can be read off a Raider.IO response, and leaving
# either empty stops the matching field appearing on a character rather than reporting
# a zero: no tier configured is not the same as a raider wearing none of it.
# Every class-set item id of the current season, comma separated.
TIER_SET_ITEM_IDS=
# Raider.IO's slug for the raid the roster is measured on, e.g. manaforge-omega.
CURRENT_RAID_SLUG=
